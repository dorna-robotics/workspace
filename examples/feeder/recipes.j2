{%- set sf = 20 -%}

# Robot (generic): base Recipe with NO component. Owns no station, does no
# boot-time IK — the stable handle for robot-level Start/Park calls
# (park(joint=...), motor). Same across every project.
robot:
  class: workspace.recipes.recipe.Recipe
  kwargs: {speed_factor: {{ sf }}}

cap_tool:
  class: workspace.recipes.tool_rack.ToolRack
  kwargs: {component: tool_rack_144mm_1, left_approach: true, speed_factor: {{ sf }}}

# ``index_list`` is the candidate-search pattern ``present_cap`` walks.
# Each entry is ``[step, preset]`` — preset is a kwargs dict for
# ``inspector.detect``. Placeholders below; replace with bench-tuned
# bounding boxes for real-mode runs.
feeder:
  class: workspace.recipes.feeder.Feeder
  kwargs:
    component: capfeeder_autosampler_2ml_1
    left_approach: false
    speed_factor: {{ sf }}
    index_list:
      - [0, {}]
      - [-1, {}]
      - [1, {}]

# The robot's mounted camera — a component like any station
# (inspection_d405_robot_1 in scene/layout.j2, bolted to robot_A5).
inspector:
  class: workspace.recipes.inspector.Inspector
  kwargs: {component: inspection_d405_robot_1, detection_preset: {}}

cap_holder:
  class: workspace.recipes.rack.Rack
  kwargs: {component: adapter_plate_autosampler_2ml_5x10_1, left_approach: false, base_distance: 150, rail_step: 5, rail_span: 5, speed_factor: {{ sf }}}
