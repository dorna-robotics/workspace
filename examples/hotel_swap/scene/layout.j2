# hotel_swap example — layout on the shared core_500 chassis.
# Devices (adapters, racks, holders, tool rack) attach to the
# fixture plates from scene/core_500.j2; populated items below.

# Hotel A — 4-level SBS-format shelf, at the syringe project's
# hotel_0 spot (fixture_plate_4 / G14).
hotel_0:
  type: "hotel_sbs_76h_4lvl"
  attach:
    parent_name: "fixture_plate_4"
    parent_solid: "body"
    parent_anchor: "G14"
    child_solid: "body"
    child_anchor: "hole_0"
    offset: [0, 0, 0, 0, 0, 90]

# Hotel B — moved to fixture_plate_6, rotated +90° about Z from
# hotel_a's orientation.
hotel_1:
  type: "hotel_sbs_76h_4lvl"
  attach:
    parent_name: "fixture_plate_6"
    parent_solid: "body"
    parent_anchor: "F9"
    child_solid: "body"
    child_anchor: "hole_0"
    offset: [0, 0, 0, 0, 0, 180]

# Two SBS plate holders on the main fixture plate. Same anchor
# pattern as the capping example's cap_holder placement that's
# known to be reachable.
sbs_adapter_0:
  type: "adapter_plate_sbs"
  attach:
    parent_name: "fixture_plate_1"
    parent_solid: "body"
    parent_anchor: "F6"
    child_solid: "body"
    child_anchor: "hole_0"
    offset: [0, 0, 0, 0, 0, 90]

sbs_adapter_1:
  type: "adapter_plate_sbs"
  attach:
    parent_name: "fixture_plate_1"
    parent_solid: "body"
    parent_anchor: "F11"
    child_solid: "body"
    child_anchor: "hole_0"
    offset: [0, 0, 0, 0, 0, 90]

# Tool rack — holds the SBS-width gripper. Same fixture_plate_5 / B18
# spot every example uses.
tool_rack_144mm_1:
  type: "tool_rack_144mm"
  attach:
    parent_name: "fixture_plate_5"
    parent_solid: "body"
    parent_anchor: "B18"
    child_solid: "body"
    child_anchor: "hole_0"
    offset: [0, 0, 0, 0, 0, 90]

# ── populated items ──────────────────────────────────────────────

# hotel_swap example — populated items:
# - gripper_sbs_width parked in the tool rack
# - 4 plates loaded in hotel A (one per shelf level)
# - 4 plates loaded in hotel B (one per shelf level)
# Each "plate" here is a rack_autosampler_2ml (empty — no tubes loaded).

gripper_sbs_width_1:
  type: "gripper_sbs_width"
  has_tool_changer: true
  attach:
    parent_name: "tool_rack_144mm_1"
    parent_solid: "body"
    parent_anchor: "place"
    child_solid: "tool_changer_tool_side"
    child_anchor: "tool_rack_connection"
    offset: [0, 0, 0, 0, 0, 0]

# Plates in hotel A — one per level.
{% for level in range(4) %}
plate_a_{{ level }}:
  type: "rack_autosampler_2ml"
  attach:
    parent_name: "hotel_0"
    parent_solid: "body"
    parent_anchor: "place_{{ level }}"
    child_solid: "body"
    child_anchor: "center"
    offset: [0, 0, 0, 0, 0, 0]
{% endfor %}

# Plates in hotel B — one per level.
{% for level in range(4) %}
plate_b_{{ level }}:
  type: "rack_autosampler_2ml"
  attach:
    parent_name: "hotel_1"
    parent_solid: "body"
    parent_anchor: "place_{{ level }}"
    child_solid: "body"
    child_anchor: "center"
    offset: [0, 0, 0, 0, 0, 0]
{% endfor %}
