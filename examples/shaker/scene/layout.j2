# shaker example — layout on the shared core_500 chassis.
#
#   - tool rack 144 (large tube gripper) on plate 5
#   - amber 40 ml rack (2×4, FULL: 8 capped tubes) on plate 4
#   - 2-slot shaker on plate 1
# All devices run in sim (no ip/port → no bus claim). For real
# hardware add ip/port + simulation: false.

# ── Tooling ─────────────────────────────────────────────────────────
tool_rack_144mm_1:
  type: "tool_rack_144mm"
  attach:
    parent_name: "fixture_plate_5"
    parent_solid: "body"
    parent_anchor: "A17"
    child_solid: "body"
    child_anchor: "hole_0"
    offset: [0, 0, 0, 0, 0, 90]

gripper_tube_large_1:
  type: "gripper_tube_large"
  has_tool_changer: true
  attach:
    parent_name: "tool_rack_144mm_1"
    parent_solid: "body"
    parent_anchor: "place"
    child_solid: "tool_changer_tool_side"
    child_anchor: "tool_rack_connection"
    offset: [0, 0, 0, 0, 0, 0]

# ── Amber 40 ml rack on plate 4 — FULL: 8 capped tubes ──────────────
adapter_plate_amber_40ml_2x4_1:
  type: "adapter_plate_amber_40ml_2x4"
  attach:
    parent_name: "fixture_plate_4"
    parent_solid: "body"
    parent_anchor: "D9"
    child_solid: "body"
    child_anchor: "hole_0"
    offset: [0, 0, 0, 0, 0, 90]

rack_amber_40ml_2x4_1:
  type: "rack_amber_40ml_2x4"
  attach:
    parent_name: "adapter_plate_amber_40ml_2x4_1"
    parent_solid: "body"
    parent_anchor: "place"
    child_solid: "body"
    child_anchor: "center"
    offset: [0, 0, 0, 0, 0, 0]

{% for r in "AB" %}
{% for c in range(1, 4+1) %}
tube_amber_40ml_{{ r }}{{ c }}:
  type: "tube_amber_40ml"
  attach:
    parent_name: "rack_amber_40ml_2x4_1"
    parent_solid: "body"
    parent_anchor: "{{ r }}{{ c }}"
    child_solid: "body"
    child_anchor: "center"
    offset: [0, 0, 0, 0, 0, 0]

cap_amber_40ml_{{ r }}{{ c }}:
  type: "cap_amber_40ml"
  attach:
    parent_name: "tube_amber_40ml_{{ r }}{{ c }}"
    parent_solid: "body"
    parent_anchor: "place"
    child_solid: "body"
    child_anchor: "center"
    offset: [0, 0, 0, 0, 0, 0]
{% endfor %}
{% endfor %}

# ── 2-slot shaker on plate 1 ────────────────────────────────────────
shaker_2slot_1:
  type: "shaker_2slot"
  attach:
    parent_name: "fixture_plate_1"
    parent_solid: "body"
    parent_anchor: "D12"
    child_solid: "body"
    child_anchor: "hole_0"
    offset: [0, 0, 0, 0, 0, 90]
