# scale example — layout on the shared core_500 chassis.
# Devices attach to the fixture plates from scene/core_500.j2.
#
# Contents:
#   - tool rack + 4-finger gripper (to pick/place tubes)
#   - SBS tube rack on plate 4, loaded with 48 plain 2 ml tubes
#   - OHAUS SPX222 balance on plate 6 (same placement as sample_prep:
#     child hole_0, offset 90). It runs in sim by default — canned
#     weight (~12.345 g). For the real balance set ip + simulation:false.

# ── Tooling ─────────────────────────────────────────────────────────
tool_rack_144mm_1:
  type: "tool_rack_144mm"
  attach:
    parent_name: "fixture_plate_5"
    parent_solid: "body"
    parent_anchor: "B18"
    child_solid: "body"
    child_anchor: "hole_0"
    offset: [0, 0, 0, 0, 0, 90]

gripper_4_finger_1:
  type: "gripper_4_finger"
  has_tool_changer: true
  attach:
    parent_name: "tool_rack_144mm_1"
    parent_solid: "body"
    parent_anchor: "place"
    child_solid: "tool_changer_tool_side"
    child_anchor: "tool_rack_connection"
    offset: [0, 0, 0, 0, 0, 0]

# ── SBS tube rack on plate 4, loaded with plain 2 ml tubes ───────────
sbs_adapter_0:
  type: "adapter_plate_sbs"
  attach:
    parent_name: "fixture_plate_4"
    parent_solid: "body"
    parent_anchor: "D6"
    child_solid: "body"
    child_anchor: "hole_0"
    offset: [0, 0, 0, 0, 0, 90]

rack_autosampler_2ml_1:
  type: "rack_autosampler_2ml"
  attach:
    parent_name: "sbs_adapter_0"
    parent_solid: "body"
    parent_anchor: "place"
    child_solid: "body"
    child_anchor: "center"
    offset: [0, 0, 0, 0, 0, 0]

# 48 tubes (6×8), one per slot.
{% for r in "ABCDEF" %}
{% for c in range(1, 8+1) %}
tube_autosampler_2ml_{{ r }}{{ c }}:
  type: "tube_autosampler_2ml"
  attach:
    parent_name: "rack_autosampler_2ml_1"
    parent_solid: "body"
    parent_anchor: "{{ r }}{{ c }}"
    child_solid: "body"
    child_anchor: "center"
    offset: [0, 0, 0, 0, 0, 0]
{% endfor %}
{% endfor %}

# ── Scale (OHAUS SPX222) ────────────────────────────────────────────
# Same placement style as sample_prep (child hole_0, offset 90). Sim by
# default: ip "" → no bus claim, weight() returns the canned reading.
# For the real balance: set ip to its address and simulation: false.
scale_spx222_1:
  type: "scale_spx222"
  ip: ""
  simulation: true
  critical: true
  attach:
    parent_name: "fixture_plate_6"
    parent_solid: "body"
    parent_anchor: "C13"
    child_solid: "body"
    child_anchor: "hole_0"
    offset: [0, 0, 0, 0, 0, 90]
