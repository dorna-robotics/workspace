{%- set sf = 20 -%}

# Robot (generic): the base Recipe with NO component. It owns no station
# and does no boot-time IK — it's just the stable handle for robot-level
# calls Start/Park make (park(joint=...), motor, axis homing via
# set_axis_with_stop / set_axis_with_encoder). Same across every project.
robot:
  class: workspace.recipes.recipe.Recipe
  kwargs: {speed_factor: {{ sf }}}

# Atlas pH probe, parked in the tool rack. Actions declare
# ``tool = "probe"`` and the engine handles pickup/return.
probe:
  class: workspace.recipes.tool_rack.ToolRack
  kwargs: {component: tool_rack_144mm_1, left_approach: true, speed_factor: {{ sf }}}

# The amber rack — ONE PhMeterSite over the adapter; per-vial dips pass
# the slot anchor (A1..A6). Motion targets the rack, device ops resolve
# through the mounted probe (core.current_tool()).
vials:
  class: workspace.recipes.ph_meter.PhMeterSite
  kwargs: {component: adapter_plate_amber_40ml_1x6_1, left_approach: true, base_distance: 200, rail_step: 25, rail_span: 1, speed_factor: {{ sf }}}

# The storage-solution cup — rinse/rest dips between vials.
storage:
  class: workspace.recipes.ph_meter.PhMeterSite
  kwargs: {component: rack_liquid_1, left_approach: false, base_distance: 100, rail_step: 25, rail_span: 1, speed_factor: {{ sf }}}
