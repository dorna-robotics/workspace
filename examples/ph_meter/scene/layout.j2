# ph_meter example — layout on the shared core_500 chassis.
# Devices attach to the fixture plates from scene/core_500.j2.
#
# Contents:
#   - 192 mm tool rack + Atlas pH probe (a tool-changer tool the robot picks)
#   - amber 40 ml rack (1x6) on plate 4, loaded with 6 OPEN vials —
#     the samples the probe measures inside
#   - one storage-solution cup (rack_liquid) beside it — the probe
#     rinses/rests there between vials
#
# The EZO circuit runs in sim by default — canned pH (~7.000). For the
# real circuit set port to its /dev/serial/by-id/... symlink and
# simulation: false. Empty port means no bus claim: no Devices-panel
# row, sim reads still work (device-guide §16).

# ── Tooling ─────────────────────────────────────────────────────────
tool_rack_192mm_1:
  type: "tool_rack_192mm"
  attach:
    parent_name: "fixture_plate_5"
    parent_solid: "body"
    parent_anchor: "B18"
    child_solid: "body"
    child_anchor: "hole_0"
    offset: [0, 0, 0, 0, 0, 90]

ph_meter_atlas_1:
  type: "ph_meter_atlas"
  has_tool_changer: true
  port: ""
  simulation: true
  critical: true
  attach:
    parent_name: "tool_rack_192mm_1"
    parent_solid: "body"
    parent_anchor: "place"
    child_solid: "tool_changer_tool_side"
    child_anchor: "tool_rack_connection"
    offset: [0, 0, 0, 0, 0, 0]

# ── Amber 40 ml vials on plate 4 — the samples ──────────────────────
adapter_plate_amber_40ml_1x6_1:
  type: "adapter_plate_amber_40ml_1x6"
  attach:
    parent_name: "fixture_plate_4"
    parent_solid: "body"
    parent_anchor: "D6"
    child_solid: "body"
    child_anchor: "hole_0"
    offset: [0, 0, 0, 0, 0, 90]

rack_amber_40ml_1x6_1:
  type: "rack_amber_40ml_1x6"
  attach:
    parent_name: "adapter_plate_amber_40ml_1x6_1"
    parent_solid: "body"
    parent_anchor: "place"
    child_solid: "body"
    child_anchor: "center"
    offset: [0, 0, 0, 0, 0, 0]

# 6 open vials (no caps — the probe dips straight in), one per slot.
{% for c in range(1, 6+1) %}
tube_amber_40ml_A{{ c }}:
  type: "tube_amber_40ml"
  attach:
    parent_name: "rack_amber_40ml_1x6_1"
    parent_solid: "body"
    parent_anchor: "A{{ c }}"
    child_solid: "body"
    child_anchor: "center"
    offset: [0, 0, 0, 0, 0, 0]
{% endfor %}

# ── Storage-solution cup — rinse/rest between vials ─────────────────
rack_liquid_1:
  type: "rack_liquid"
  attach:
    parent_name: "fixture_plate_4"
    parent_solid: "body"
    parent_anchor: "D10"
    child_solid: "body"
    child_anchor: "hole_0"
    offset: [0, 0, 0, 0, 0, 0]
