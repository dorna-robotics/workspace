core:
  type: "core"
  simulation: true
  ip: "192.168.254.116"
  has_rail: true
  rail_offset: -31.55
  has_tool_changer: true
  has_motion_plan: true
  has_camera: true
  camera_serial_number: "315122271350"
  robot_attach:
    rail_carriage_anchor: "hole_1"
    robot_A0_anchor: "hole_0"
    offset: [0, 0, 0, 0, 0, 0]
  rail_cfg:
    type: "rail_hd_500mm"
    axis: 6
    offset: 0
    usem: 1
    pprm: 4000
    tprm: 75
    usee: 1
    ppre: 4000
    tpre: 75
    p: 0.01
    i: 0.0001
    d: 0
    duration: 100
    threshold: 100
  attach:
    parent_name: "fixture_plate_2"
    parent_solid: "body"
    parent_anchor: "G6"
    child_solid: "rail_base"
    child_anchor: "hole_2"
    offset: [0, 0, 0, 0, 0, 0]

fixture_plate_1:
  type: "fixture_plate"
  offset: [0, 0, 0, 0, 0, 0]

fixture_plate_2:
  type: "fixture_plate"
  attach:
    parent_name: "fixture_plate_1"
    parent_solid: "body"
    parent_anchor: "corner_2"
    child_solid: "body"
    child_anchor: "corner_3"
    offset: [0, 0, 0, 0, 0, 0]

fixture_plate_4:
  type: "fixture_plate"
  attach:
    parent_name: "fixture_plate_1"
    parent_solid: "body"
    parent_anchor: "corner_2"
    child_solid: "body"
    child_anchor: "corner_1"
    offset: [0, 0, 0, 0, 0, 0]

fixture_plate_3:
  type: "fixture_plate"
  attach:
    parent_name: "fixture_plate_4"
    parent_solid: "body"
    parent_anchor: "corner_1"
    child_solid: "body"
    child_anchor: "corner_0"
    offset: [0, 0, 0, 0, 0, 0]

apc_adapter_1:
  type: "apc_adapter"
  attach:
    parent_name: "fixture_plate_3"
    parent_solid: "body"
    parent_anchor: "I2"
    child_solid: "body"
    child_anchor: "hole_3"
    offset: [0, 0, 0, 0, 0, 0]

apc_base_1:
  type: "apc_base"
  attach:
    parent_name: "apc_adapter_1"
    parent_solid: "body"
    parent_anchor: "place_2"
    child_solid: "body"
    child_anchor: "hole_2"
    offset: [0, 0, 0, 0, 0, 0]

probe_spring_1:
  type: "probe_spring"
  # IO config must be a LIST of triplets ([[pin, state, delay], ...]) —
  # rt.output loops over it. Passing a flat triplet raises
  # "TypeError: object of type 'int' has no len()" inside the runtime.
  output_enable:  [[4, 1, 0.1]]
  output_disable: [[4, 0, 0.1]]
  attach:
    parent_name: "fixture_plate_4"
    parent_solid: "body"
    parent_anchor: "E20"
    child_solid: "housing"
    child_anchor: "hole_1"
    offset: [0, 0, 0, 0, 0, 180]

# Calibration scene == base scene, but the robot carries the offset probe
# rod instead of the working gripper. Swap the type to "gripper_probe_90"
# if you are calibrating sideways-facing pockets. No probe_tool_2 jig is
# mounted — the pockets come from each component's clb_* anchors.
gripper_probe_offset_1:
  type: "gripper_probe_offset"
  has_tool_changer: true
  attach:
    parent_name: "core"
    parent_solid: "tool_changer_robot_side"
    parent_anchor: "tool_changer_connection"
    child_solid: "tool_changer_tool_side"
    child_anchor: "tool_changer_connection"
    offset: [0, 0, 0, 0, 0, 0]

disc_holder_seven_1:
  type: "disc_holder_seven"
  attach:
    parent_name: "fixture_plate_4"
    parent_solid: "body"
    parent_anchor: "G14"
    child_solid: "body"
    child_anchor: "hole0"
    offset: [0, 0, 0, 0, 0, 0]

disc_holder_seven_output_1:
  type: "disc_holder_seven_output"
  attach:
    parent_name: "fixture_plate_3"
    parent_solid: "body"
    parent_anchor: "H4"
    child_solid: "body"
    child_anchor: "hole3"
    offset: [0, 0, 0, 0, 0, 0]
