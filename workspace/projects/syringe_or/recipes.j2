{% set speed_scale = 1 %}

tool_rack_2:
  class: workspace.recipes.tool_rack.ToolRack
  kwargs:
    component: tool_rack_2
    left_approach: true
    speed_scale: {{ speed_scale }}

tool_rack_1:
  class: workspace.recipes.tool_rack.ToolRack
  kwargs:
    component: tool_rack_1
    left_approach: true
    speed_scale: {{ speed_scale }}

tool_rack_0:
  class: workspace.recipes.tool_rack.ToolRack
  kwargs:
    component: tool_rack_0
    left_approach: true
    speed_scale: {{ speed_scale }}

hotel:
