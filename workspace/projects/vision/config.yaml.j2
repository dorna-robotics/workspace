core:
  type: core
  simulation: True
  has_camera: False
  has_rail: True
  ip: "192.168.254.106"
  has_toolchanger: True 
  toolchanger_output: 0
  attach:
    parent_name: fixture_plate_1
    parent_solid: fixture_plate
    parent_anchor: E10
    child_solid: rail_base
    child_anchor: hole_0
    offset: [0, 0, 0, 0, 0, 0]
  robot_attach:
    rail_carriage_anchor: hole_1
    robot_A0_anchor: hole_0
    offset: [0, 0, 0, 0, 0, 0]

fixture_plate_1:
  type: fixture_plate

fixture_plate_2:
  type: fixture_plate
  attach:
    parent_name: fixture_plate_1
    parent_solid: fixture_plate
    parent_anchor: corner_3
    child_solid: fixture_plate
    child_anchor: corner_0

fixture_plate_3:
  type: fixture_plate
  attach:
    parent_name: fixture_plate_1
    parent_solid: fixture_plate
    parent_anchor: corner_1
    child_solid: fixture_plate
    child_anchor: corner_0

fixture_plate_4:
  type: fixture_plate
  attach:
    parent_name: fixture_plate_1
    parent_solid: fixture_plate
    parent_anchor: corner_2
    child_solid: fixture_plate
    child_anchor: corner_0

tool_rack_1:
  type: tool_rack
  attach:
    parent_name: fixture_plate_3
    parent_solid: fixture_plate
    parent_anchor: E19
    child_solid: tool_rack
    child_anchor: center
    offset: [0,0,0,0,0,90]

gripper_1:
  type: tube_gripper_4_finger
  has_toolchanger: True 
  attach:
    parent_name: tool_rack_1
    parent_solid: tool_rack
    parent_anchor: tool_connection
    child_solid: toolchanger_tool_side
    child_anchor: tool_rack_connection




decapper_1:
  type: decapper
  enable: [0, 0]
  attach:
    parent_name: fixture_plate_4
    parent_solid: fixture_plate
    parent_anchor: D9
    child_solid: solid_0
    child_anchor: center

sbs_adapter_2:
  type: sbs_adapter
  attach:
    parent_name: fixture_plate_4
    parent_solid: fixture_plate
    parent_anchor: H2
    child_solid: solid_0
    child_anchor: center


capholder_1:
  type: capholder_autosampler_2ml
  attach:
    parent_name: sbs_adapter_2
    parent_solid: solid_0
    parent_anchor: center
    child_solid: solid_0
    child_anchor: center

sbs_adapter_1:
  type: sbs_adapter
  attach:
    parent_name: fixture_plate_4
    parent_solid: fixture_plate
    parent_anchor: D2
    child_solid: solid_0
    child_anchor: center


microplate_1:
  type: plate_autosampler_2ml
  full: False
  attach:
    parent_name: sbs_adapter_1
    parent_solid: solid_0
    parent_anchor: center
    child_solid: solid_0
    child_anchor: center

{% for r in "AB" %}
{% for c in range(1, 2) %}
body_{{ r }}{{ c }}:
  type: body_autosampler_2ml
  attach:
    parent_name: microplate_1
    parent_solid: solid_0
    parent_anchor: {{ r }}{{ c }}
    child_solid: solid_0
    child_anchor: center

cap_{{ r }}{{ c }}:
  type: cap_autosampler_2ml
  attach:
    parent_name: body_{{ r }}{{ c }}
    parent_solid: solid_0
    parent_anchor: place
    child_solid: solid_0
    child_anchor: center

{% endfor %}
{% endfor %}



feeder:
  type: capfeeder_autosampler_2ml
  attach:
    parent_name: fixture_plate_2
    parent_solid: fixture_plate
    parent_anchor: E11
    child_solid: solid_0
    child_anchor: center
    offset: [0, 0, 0, 0, 0, 180]


microtube_feeder:
  type: body_micronic_075ml
  attach:
    parent_name: feeder
    parent_solid: solid_0
    parent_anchor: place
    child_solid: solid_0
    child_anchor: center

