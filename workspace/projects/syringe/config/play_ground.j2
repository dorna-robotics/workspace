gripper_0:
  type: gripper_4_finger
  has_tool_changer: True 
  attach:
    parent_name: tool_rack_0
    parent_solid: body
    parent_anchor: place
    child_solid: tool_changer_tool_side
    child_anchor: tool_rack_connection

gripper_1:
  type: gripper_suction
  has_tool_changer: True 
  attach:
    parent_name: tool_rack_1
    parent_solid: body
    parent_anchor: place
    child_solid: tool_changer_tool_side
    child_anchor: tool_rack_connection

{% for index in range(1) %}
microplate_{{ index }}:
  type: rack_autosampler_2ml
  attach:
    parent_name: sbs_adapter_{{ index }}
    parent_solid: body
    parent_anchor: place
    child_solid: body
    child_anchor: center

{% for r in "A" %}
{% for c in range(1, 2) %}
tube_{{ index }}_{{ r }}{{ c }}:
  type: tube_autosampler_2ml
  attach:
    parent_name: microplate_{{ index }}
    parent_solid: body
    parent_anchor: {{ r }}{{ c }}
    child_solid: body
    child_anchor: center
cap_{{ index }}_{{ r }}{{ c }}:
  type: cap_autosampler_2ml
  attach:
    parent_name: tube_{{ index }}_{{ r }}{{ c }}
    parent_solid: body
    parent_anchor: place
    child_solid: body
    child_anchor: center
{% endfor %}
{% endfor %}
{% endfor %}


{% for level in range(4) %}
{% for r in "ABCDEF" %}
{% for c in range(1, 9) %}
cap_{{level}}_{{ r }}{{ c }}:
  type: cap_autosampler_2ml
  attach:
    parent_name: feeder
    parent_solid: body
    parent_anchor: place
    child_solid: body
    child_anchor: center
{% endfor %}
{% endfor %}
{% endfor %}

capholder:
  type: capholder_autosampler_2ml
  attach:
    parent_name: sbs_adapter_1
    parent_solid: body
    parent_anchor: place
    child_solid: body
    child_anchor: center