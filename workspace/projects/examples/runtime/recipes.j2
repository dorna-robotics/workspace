{%- set sf = 20 -%}

# Robot (generic): base Recipe with NO component. Owns no station, does no
# boot-time IK — the stable handle for robot-level Start/Park calls
# (park(joint=...), motor). Same across every project.
robot:
  class: workspace.recipes.recipe.Recipe
  kwargs: {speed_factor: {{ sf }}}

# Suction tool, parked in the tool rack. Actions that move discs set
# ``tool = "gripper"`` so the framework swaps to it.
gripper:
  class: workspace.recipes.tool_rack.ToolRack
  kwargs: {component: tool_rack_144mm_1, left_approach: true, speed_factor: {{ sf }}}

# Disc in/out holders. Each Rack recipe targets the adapter_disc_holder
# and the resolver walks down to the stack_holder sitting on it (at the
# adapter's ``place`` anchor). Slots are A1..A7.
disc_in_1:
  class: workspace.recipes.rack.Rack
  kwargs: {component: adapter_disc_holder_1, left_approach: true, base_distance: 150, rail_step: 5, rail_span: 20, speed_factor: {{ sf }}}

disc_in_2:
  class: workspace.recipes.rack.Rack
  kwargs: {component: adapter_disc_holder_2, left_approach: true, base_distance: 150, rail_step: 5, rail_span: 20, speed_factor: {{ sf }}}

disc_out_1:
  class: workspace.recipes.rack.Rack
  kwargs: {component: adapter_disc_holder_3, left_approach: true, base_distance: 150, rail_step: 5, rail_span: 20, speed_factor: {{ sf }}}

disc_out_2:
  class: workspace.recipes.rack.Rack
  kwargs: {component: adapter_disc_holder_4, left_approach: true, base_distance: 150, rail_step: 5, rail_span: 20, speed_factor: {{ sf }}}

disc_out_3:
  class: workspace.recipes.rack.Rack
  kwargs: {component: adapter_disc_holder_5, left_approach: true, base_distance: 150, rail_step: 5, rail_span: 20, speed_factor: {{ sf }}}
