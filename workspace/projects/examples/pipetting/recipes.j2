{%- set sf = 20 -%}

gripper:
  class: workspace.recipes.tool_rack.ToolRack
  kwargs: {component: tool_rack_144mm_1, left_approach: true, speed_factor: {{ sf }}}

# PipettingSite recipe on the falcon adapter — exposes immerse /
# aspirate / retract / dispense for tubes sitting in the rack
# below the adapter resolver.
falcon_pipette:
  class: workspace.recipes.pipetting.PipettingSite
  kwargs: {component: adapter_falcon, base_distance: 200, rail_step: 25, rail_span: 20, speed_factor: {{ sf }}}

# Tip rack — pick_tip pulls a fresh tip onto the pipettor.
tip_rack:
  class: workspace.recipes.pipetting.PipettingSite
  kwargs: {component: adapter_sbs_0, base_distance: 250, rail_step: 25, rail_span: 20, speed_factor: {{ sf }}}

# Waste bin — eject_tip drops the used tip here.
waste_bin:
  class: workspace.recipes.pipetting.PipettingSite
  kwargs: {component: adapter_sbs_1, base_distance: 250, rail_step: 25, rail_span: 20, speed_factor: {{ sf }}}
