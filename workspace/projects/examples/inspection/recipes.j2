{%- set sf = 20 -%}

# Robot (generic): base Recipe with NO component. Owns no station, does no
# boot-time IK — the stable handle for robot-level Start/Park calls
# (park(joint=...), motor). Same across every project.
robot:
  class: workspace.recipes.recipe.Recipe
  kwargs: {speed_factor: {{ sf }}}

# 4-finger gripper, parked in the tool rack.
gripper:
  class: workspace.recipes.tool_rack.ToolRack
  kwargs: {component: tool_rack_144mm_1, left_approach: true, speed_factor: {{ sf }}}

# Tube rack — Rack recipe over the SBS adapter; resolver walks down to
# rack_autosampler_2ml_1. Slots A1..F8.
tube_rack:
  class: workspace.recipes.rack.Rack
  kwargs: {component: sbs_adapter_0, left_approach: false, base_distance: 100, rail_step: 25, rail_span: 20, speed_factor: {{ sf }}}

# ── Inspection recipes go here next ─────────────────────────────────
# e.g. a MobileInspector / fixed inspection_vertical_144mm recipe.

# Two fixed inspection stations. FixedInspector.present(...) moves the
# robot so the held tube faces the station's camera; detect() runs the
# (sim-safe) detection.
inspector_1:
  class: workspace.recipes.inspector.FixedInspector
  kwargs: {component: inspection_vertical_144mm_1, base_distance: 200, rail_step: 5, rail_span: 5, detection_preset: {}, speed_factor: {{ sf }}}

inspector_2:
  class: workspace.recipes.inspector.FixedInspector
  kwargs: {component: inspection_horizontal_1, base_distance: 200, rail_step: 5, rail_span: 5, detection_preset: {}, speed_factor: {{ sf }}}
