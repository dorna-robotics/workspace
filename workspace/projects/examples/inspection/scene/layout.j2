# inspection example — layout on the shared core_500 chassis.
# Devices attach to the fixture plates from scene/core_500.j2.
#
# Contents:
#   - tool rack + 4-finger gripper (to pick/present tubes)
#   - inspection_horizontal_144mm — fixed vision station mounted on a
#     plate (same pattern as the printer's ``vision_station``)
#   - inspection_module — a stand-alone vision module on the ground
#   - SBS tube rack fully loaded with 48 capped 2 ml tubes (a cap sits
#     on each tube's ``cap_seat``)

# ── Tooling ─────────────────────────────────────────────────────────
tool_rack_144mm_1:
  type: "tool_rack_144mm"
  attach:
    parent_name: "fixture_plate_5"
    parent_solid: "body"
    parent_anchor: "B18"
    child_solid: "body"
    child_anchor: "hole_0"
    offset: [0, 0, 0, 0, 0, 90]

gripper_4_finger_1:
  type: "gripper_4_finger"
  has_tool_changer: true
  attach:
    parent_name: "tool_rack_144mm_1"
    parent_solid: "body"
    parent_anchor: "place"
    child_solid: "tool_changer_tool_side"
    child_anchor: "tool_rack_connection"
    offset: [0, 0, 0, 0, 0, 0]

# ── Inspection ──────────────────────────────────────────────────────
# Fixed vision station mounted on a plate (printer-like).
inspection_horizontal_144mm_1:
  type: "inspection_horizontal_144mm"
  attach:
    parent_name: "fixture_plate_3"
    parent_solid: "body"
    parent_anchor: "H2"
    child_solid: "body"
    child_anchor: "hole_0"
    offset: [0, 0, 0, 0, 0, 90]

# Stand-alone inspection module sitting on the ground (free-standing).
inspection_module_1:
  type: "inspection_module"
  offset: [600, -300, 0, 0, 0, 0]

# ── SBS tube rack, fully loaded with capped 2 ml tubes ──────────────
sbs_adapter_0:
  type: "adapter_plate_sbs"
  attach:
    parent_name: "fixture_plate_4"
    parent_solid: "body"
    parent_anchor: "D6"
    child_solid: "body"
    child_anchor: "hole_0"
    offset: [0, 0, 0, 0, 0, 90]

rack_autosampler_2ml_1:
  type: "rack_autosampler_2ml"
  attach:
    parent_name: "sbs_adapter_0"
    parent_solid: "body"
    parent_anchor: "place"
    child_solid: "body"
    child_anchor: "center"
    offset: [0, 0, 0, 0, 0, 0]

# 48 tubes (6×8), one per slot.
{% for r in "ABCDEF" %}
{% for c in range(1, 8+1) %}
tube_autosampler_2ml_{{ r }}{{ c }}:
  type: "tube_autosampler_2ml"
  attach:
    parent_name: "rack_autosampler_2ml_1"
    parent_solid: "body"
    parent_anchor: "{{ r }}{{ c }}"
    child_solid: "body"
    child_anchor: "center"
    offset: [0, 0, 0, 0, 0, 0]
{% endfor %}
{% endfor %}

# A cap seated on each tube (capped tubes).
{% for r in "ABCDEF" %}
{% for c in range(1, 8+1) %}
cap_autosampler_2ml_{{ r }}{{ c }}:
  type: "cap_autosampler_2ml"
  attach:
    parent_name: "tube_autosampler_2ml_{{ r }}{{ c }}"
    parent_solid: "body"
    parent_anchor: "cap_seat"
    child_solid: "body"
    child_anchor: "center"
    offset: [0, 0, 0, 0, 0, 0]
{% endfor %}
{% endfor %}
