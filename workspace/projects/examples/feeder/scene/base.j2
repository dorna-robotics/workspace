# feeder example — base scene.
#
# Minimal viable workspace for the feeder demo:
#   - Core (robot) with rail + tool-changer, simulation on
#   - 4 chained fixture plates (rail mount + device mounts)
#   - One tool rack holding the suction gripper
#   - Cap feeder (autosampler-style — rotating plate that brings caps
#     to its ``place`` anchor)
#   - Cap holder (5×10 grid where caps land)
#
# Geometry copied from ``sample_prep/scene/base.j2`` so the kinematics
# are known-good. If you're adapting this example to a different
# bench, the components stay the same — you only tune the
# ``attach.parent_anchor`` values to match where things sit on your
# fixture plate.

core:
  type: "core"
  simulation: true
  ip: ""
  has_rail: true
  has_tool_changer: true
  has_motion_plan: true
  has_camera: true
  camera_cfg:
    serial_number: ""
  robot_attach:
    rail_carriage_anchor: "hole_1"
    robot_A0_anchor: "hole_0"
    offset: [0, 0, 0, 0, 0, 0]
  rail_cfg:
    type: "rail_hd_500mm"
    axis: 6
    offset: 0
    usem: 1
    pprm: 4000
    tprm: 75
    usee: 1
    ppre: 4000
    tpre: 75
    p: 0.01
    i: 0.0001
    d: 0
    duration: 100
    threshold: 100
  attach:
    parent_name: "fixture_plate_2"
    parent_solid: "body"
    parent_anchor: "D10"
    child_solid: "rail_base"
    child_anchor: "hole_0"
    offset: [0, 0, 0, 0, 0, 0]

# Fixture-plate chain. Mirrors sample_prep's layout truncated to
# plates 1–6: plates 1/2/3 form one wing (corner_0 → corner_3),
# plates 1/4/5/6 form the other (corner_2 + corner_0). Geometry
# matches sample_prep so anchors line up the same way.
fixture_plate_1:
  type: "fixture_plate"
  offset: [0, 0, 0, 0, 0, 0]

fixture_plate_2:
  type: "fixture_plate"
  attach:
    parent_name: "fixture_plate_1"
    parent_solid: "body"
    parent_anchor: "corner_0"
    child_solid: "body"
    child_anchor: "corner_3"
    offset: [0, 0, 0, 0, 0, 0]

fixture_plate_3:
  type: "fixture_plate"
  attach:
    parent_name: "fixture_plate_2"
    parent_solid: "body"
    parent_anchor: "corner_0"
    child_solid: "body"
    child_anchor: "corner_3"
    offset: [0, 0, 0, 0, 0, 0]

fixture_plate_4:
  type: "fixture_plate"
  attach:
    parent_name: "fixture_plate_1"
    parent_solid: "body"
    parent_anchor: "corner_2"
    child_solid: "body"
    child_anchor: "corner_3"
    offset: [0, 0, 0, 0, 0, 0]

fixture_plate_5:
  type: "fixture_plate"
  attach:
    parent_name: "fixture_plate_4"
    parent_solid: "body"
    parent_anchor: "corner_0"
    child_solid: "body"
    child_anchor: "corner_3"
    offset: [0, 0, 0, 0, 0, 0]

fixture_plate_6:
  type: "fixture_plate"
  attach:
    parent_name: "fixture_plate_5"
    parent_solid: "body"
    parent_anchor: "corner_0"
    child_solid: "body"
    child_anchor: "corner_3"
    offset: [0, 0, 0, 0, 0, 0]

# Cap feeder — rotating plate that brings one cap at a time to its
# ``place`` anchor. Caps are loaded in ``layout.j2`` (stacked at
# ``place``).
capfeeder_autosampler_2ml_1:
  type: "capfeeder_autosampler_2ml"
  attach:
    parent_name: "fixture_plate_1"
    parent_solid: "body"
    parent_anchor: "G5"
    child_solid: "body"
    child_anchor: "hole_0"
    offset: [0, 0, 0, 0.0002, 0, -90]

# Cap holder — 5×10 grid where caps land. Uses an adapter plate as the
# rack-mounting base.
adapter_plate_autosampler_2ml_5x10_1:
  type: "adapter_plate_autosampler_2ml_5x10"
  attach:
    parent_name: "fixture_plate_1"
    parent_solid: "body"
    parent_anchor: "C15"
    child_solid: "body"
    child_anchor: "hole_0"
    offset: [0, 0, 0, 0, 0, 90]

capholder_autosampler_2ml_5x10_1:
  type: "capholder_autosampler_2ml_5x10"
  attach:
    parent_name: "adapter_plate_autosampler_2ml_5x10_1"
    parent_solid: "body"
    parent_anchor: "place"
    child_solid: "body"
    child_anchor: "center"
    offset: [0, 0, 0, 0, 0, 0]

# Inspector — fixed horizontal camera the feeder uses for vision-driven
# cap detection. ``present_cap`` (called from FeedCap) cycles through
# the recipe's ``index_list`` and calls ``inspector.detect(...)`` at
# each candidate slot; in simulation the call returns True for the
# first preset, so the feeder doesn't actually rotate. In real mode
# the bounding-box presets in ``index_list`` are tuned per bench so
# the right slot wins.
#
# Placed at fixture_plate_6 / J18 — same J18 anchor sample_prep uses
# for its inspector, mounted on a different plate because the feeder
# example only has plates 1–6.
inspection_horizontal_144mm_1:
  type: "inspection_horizontal_144mm"
  attach:
    parent_name: "fixture_plate_6"
    parent_solid: "body"
    parent_anchor: "J18"
    child_solid: "body"
    child_anchor: "hole_0"
    offset: [0, 0, 0, 0, 0, 180]

# Tool rack — holds the suction gripper when it's not on the robot.
# Positioned at fixture_plate_5 / B18, matching the slot
# sample_prep uses for its ``tool_rack_144mm_3`` (the suction-tool
# slot). Only one rack is needed here; sample_prep has four.
tool_rack_144mm_1:
  type: "tool_rack_144mm"
  attach:
    parent_name: "fixture_plate_5"
    parent_solid: "body"
    parent_anchor: "B18"
    child_solid: "body"
    child_anchor: "hole_0"
    offset: [0, 0, 0, 0, 0, 90]
