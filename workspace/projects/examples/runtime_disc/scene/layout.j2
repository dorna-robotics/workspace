# runtime_disc example — layout on top of the shared core_500 chassis.
#
# Deliberately minimal: just a tool rack and a parked gripper so the
# robot has something to hold. The DISC is NOT here — it's created at
# runtime via workspace.add_component (see actions.py), which is the
# whole point of this example.

tool_rack_144mm_1:
  type: "tool_rack_144mm"
  attach:
    parent_name: "fixture_plate_5"
    parent_solid: "body"
    parent_anchor: "B18"
    child_solid: "body"
    child_anchor: "hole_0"
    offset: [0, 0, 0, 0, 0, 90]

gripper_suction_1:
  type: "gripper_suction"
  has_tool_changer: true
  attach:
    parent_name: "tool_rack_144mm_1"
    parent_solid: "body"
    parent_anchor: "place"
    child_solid: "tool_changer_tool_side"
    child_anchor: "tool_rack_connection"
    offset: [0, 0, 0, 0, 0, 0]

adapter_disc_holder_1:
  type: "adapter_disc_holder"
  attach:
    parent_name: "fixture_plate_1"
    parent_solid: "body"
    parent_anchor: "J6"
    child_solid: "body"
    child_anchor: "hole_1"
    offset: [0, 0, 0, 0, 0, 0]

stack_holder_disc_in_1:
  type: "stack_holder_disc_in"
  attach:
    parent_name: "adapter_disc_holder_1"
    parent_solid: "body"
    parent_anchor: "place"
    child_solid: "body"
    child_anchor: "center"
    offset: [0, 0, 0, 0, 0, 0]

