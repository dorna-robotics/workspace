# test/recipes.j2 — recipe instances available to states.py.
# BaseWorkflow loads this and instantiates each entry as
# ``cls(workspace, core, workspace.components[component], **kwargs)``;
# the result is keyed by the alias and exposed to States via ``rcp[alias]``.

{% set speed_factor = 0.5 %}

inspector:
  class: workspace.recipes.inspector.FixedInspector
  kwargs:
    component: vision_station
    speed_factor: {{ speed_factor }}
