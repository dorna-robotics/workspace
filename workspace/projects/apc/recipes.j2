{%- set sf = 20 -%}

# Generic robot-motion recipe (park / joint moves). No tool rack in this
# cell — the suction gripper is mounted directly on the robot — so there
# is no tool recipe; Start/Park just move the robot via rcp["robot"].park().
robot:
  class: workspace.recipes.robot.Robot
  kwargs: {speed_factor: {{ sf }}}

